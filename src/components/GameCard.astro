---
import { Image } from 'astro:assets';
import { BADGE_LABEL, priceText, ratingText, type Game } from '../lib/games';
import { getCover } from '../lib/images';
import { withBase } from '../lib/base';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const cover = getCover(game.cover);
const badgeClass = `badge badge--${game.badge}`;
---

<article
  class="card game-card"
  data-category={game.category}
  data-badge={game.badge}
  data-search={`${game.title} ${game.category} ${game.tags.join(' ')} ${BADGE_LABEL[game.badge]}`.toLowerCase()}
>
  <a class="card-link" href={withBase(`/games/${game.slug}/`)}>
    <div class="card-media">
      <Image
        src={cover}
        alt={`${game.title} 封面`}
        widths={[400, 600, 1200]}
        sizes="(max-width: 639px) 100vw, (max-width: 1023px) 45vw, 360px"
        loading="lazy"
        decoding="async"
      />
      <span class={badgeClass}>{BADGE_LABEL[game.badge]}</span>
    </div>

    <div class="card-body">
      <div class="card-meta">
        <span>{game.category}</span>
        <span class="dot"></span>
        <span>{game.platform.join(' · ')}</span>
      </div>

      <h3 class="card-title">{game.title}</h3>
      <p class="card-desc clamp-2">{game.description}</p>

      <div class="card-tags">
        {game.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
      </div>

      <div class="card-foot">
        <span class="pricing">
          <span class="price">{priceText(game)}</span>
          {game.originalPrice && <s class="price-old">¥{game.originalPrice}</s>}
        </span>
        <span class="rating">
          {game.rating === null ? (
            <span class="rating-pending">评分待定</span>
          ) : (
            <>
              <span class="rating-num">{ratingText(game.rating)}</span>
              <span class="rating-max">/10</span>
            </>
          )}
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .game-card :global(.badge) {
    position: absolute;
    top: 10px;
    left: 10px;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-desc {
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .pricing {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .price {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
  }

  .price-old {
    font-size: 12px;
    color: var(--ink-3);
  }

  .rating-pending {
    font-family: var(--font);
    font-size: 12px;
    color: var(--ink-3);
  }
</style>
