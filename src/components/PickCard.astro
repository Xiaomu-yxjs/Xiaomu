---
import { Image } from 'astro:assets';
import { ratingText, priceText, playersText, type Game } from '../lib/games';
import { getCover, getIcon } from '../lib/images';
import { withBase } from '../lib/base';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const cover = getCover(game.cover);
const icon = getIcon(game.icon);
---

<a class="card pick" href={withBase(`/games/${game.slug}/`)}>
  <div class="card-media">
    <Image
      src={cover}
      alt={`${game.title} 封面`}
      widths={[480, 720, 1200]}
      sizes="(max-width: 639px) 100vw, (max-width: 1023px) 45vw, 380px"
      loading="lazy"
      decoding="async"
    />
    {icon && (
      <Image
        class="card-icon"
        src={icon}
        alt={`${game.title} 图标`}
        widths={[96, 144]}
        sizes="72px"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span>{game.category}</span>
      <span class="dot"></span>
      <span>{playersText(game)}</span>
      <span class="dot"></span>
      <span>{priceText(game)}</span>
    </div>

    <h3 class="card-title">{game.title}</h3>
    <p class="card-desc clamp-2">{game.description}</p>

    <div class="card-tags">
      {game.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
    </div>

    <div class="card-foot">
      <span class="rating">
        <span class="rating-num">{ratingText(game.rating)}</span>
        <span class="rating-max">{game.rating === null ? '' : ' / 10'}</span>
      </span>
      <span class="go">看测评 <span aria-hidden="true">→</span></span>
    </div>
  </div>
</a>

<style>
  .pick {
    min-height: 100%;
  }

  .pick :global(.card-icon) {
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    object-fit: cover;
    border: 2px solid rgb(255 255 255 / 0.85);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.45), var(--glow);
    background: #0d1410;
  }

  .card-desc {
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .go {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-ink);
  }
</style>
