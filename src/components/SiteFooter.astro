---
import { withBase } from '../lib/base';
const year = new Date().getFullYear();
---

<footer class="ftr" id="about">
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-brand">
        <div class="ftr-title">苜蓿草 <span>CLOVER</span></div>
        <p class="ftr-desc">
          一个为你推荐优质游戏的手游测评站
        </p>
      </div>

      <nav class="ftr-cols" aria-label="页脚导航">
        <div class="ftr-col">
          <h3>浏览</h3>
          <a href={withBase('/')}>首页</a>
          <a href={withBase('/library/')}>游戏库</a>
        </div>
        <div class="ftr-col">
          <h3>说明</h3>
          <a href={withBase('/library/?badge=pick')}>编辑部精选</a>
          <a href={withBase('/#about')}>数据来源</a>
        </div>
      </nav>
    </div>

    <div class="ftr-bottom">
      <p class="disclaimer">
        <strong>数据说明：</strong>本站为个人测评网站，请勿作为消费或下载依据。
      </p>
      <p class="copy">© {year} 苜蓿草 · Built with Astro</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 -1px 0 rgba(92, 224, 144, 0.16), 0 -12px 34px -20px rgba(92, 224, 144, 0.5);
    padding-block: var(--sp-8) var(--sp-5);
  }

  .ftr-top {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-7);
    flex-wrap: wrap;
  }

  .ftr-brand {
    max-width: 420px;
  }

  .ftr-title {
    font-size: 18px;
    font-weight: 700;
  }

  .ftr-title span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    margin-left: 6px;
    font-weight: 400;
  }

  .ftr-desc {
    margin-top: var(--sp-3);
    color: var(--ink-2);
    font-size: 14px;
  }

  .ftr-cols {
    display: flex;
    gap: var(--sp-8);
  }

  .ftr-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }

  .ftr-col h3 {
    font-size: 12px;
    font-family: var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 500;
    margin-bottom: 2px;
  }

  .ftr-col a {
    color: var(--ink-2);
    transition: color 0.18s var(--ease);
  }

  .ftr-col a:hover {
    color: var(--ink);
  }

  .ftr-bottom {
    margin-top: var(--sp-7);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--ink-3);
  }

  .disclaimer {
    max-width: 66ch;
    line-height: 1.7;
  }

  .disclaimer strong {
    color: var(--ink-2);
  }

  .copy {
    font-family: var(--mono);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .ftr-top {
      gap: var(--sp-6);
    }
    .ftr-cols {
      gap: var(--sp-7);
    }
  }
</style>
