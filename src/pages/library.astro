---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import { BADGE_LABEL, categories, games } from '../lib/games';

// 只展示当前确实存在的标记，避免出现点了必定零结果的筛选项
const usedBadges = [...new Set(games.map((g) => g.badge))];
const badges = [
  { value: 'all', label: '全部' },
  ...usedBadges.map((b) => ({ value: b, label: BADGE_LABEL[b] })),
];
---

<BaseLayout
  title="游戏库 · 全部手游测评 | 苜蓿草"
  description="按类别、标签、关键词筛选全部手游测评。每款都有评分、玩法、平台与适合人群说明。"
>
  <section class="lib-head">
    <div class="wrap">
      <p class="eyebrow">Library</p>
      <h1 class="lib-title">游戏库</h1>
      <p class="lib-sub">共 {games.length} 款。</p>
    </div>
  </section>

  <section class="wrap lib-body">
    <div class="filter" id="filter" role="search">
      <!-- 收起态：只留一条紧凑的可展开条 -->
      <button
        class="filter-peek"
        type="button"
        id="filter-toggle"
        aria-expanded="true"
        aria-controls="filter-body"
      >
        <svg class="peek-ico" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
          <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span class="peek-summary" id="peek-summary">搜索 / 筛选</span>
        <span class="peek-count" id="peek-count">共 {games.length} 款</span>
        <svg class="peek-caret" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="filter-body" id="filter-body">
        <div class="filter-search">
          <svg class="ico" viewBox="0 0 20 20" aria-hidden="true" width="16" height="16">
            <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <input
            id="q"
            type="search"
            placeholder="搜游戏名、类别或标签…"
            autocomplete="off"
            aria-label="搜索游戏"
          />
        </div>

        <div class="filter-row" role="group" aria-label="按类别筛选">
          <span class="filter-label">类别</span>
          <div class="chips">
            {categories.map((c) => (
              <button class="chip" type="button" data-filter="category" data-value={c}>{c}</button>
            ))}
          </div>
        </div>

        <div class="filter-row" role="group" aria-label="按标记筛选">
          <span class="filter-label">标记</span>
          <div class="chips">
            {badges.map((b) => (
              <button class="chip" type="button" data-filter="badge" data-value={b.value}>{b.label}</button>
            ))}
          </div>
        </div>

        <div class="filter-foot">
          <p class="count" id="count" aria-live="polite">共 {games.length} 款</p>
          <button class="reset" type="button" id="reset">重置筛选</button>
        </div>
      </div>
    </div>

    <div class="grid" id="grid">
      {games.map((game) => <GameCard game={game} />)}
    </div>

    <div class="empty" id="empty" hidden>
      <p class="empty-title">没有匹配的游戏</p>
      <p class="empty-sub">换个关键词，或者点「重置筛选」看看全部。</p>
      <button class="btn btn--ghost" type="button" id="empty-reset">重置筛选</button>
    </div>
  </section>
</BaseLayout>

<script>
  type State = { q: string; category: string; badge: string };

  const grid = document.getElementById('grid');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.game-card'));
  const qInput = document.getElementById('q') as HTMLInputElement | null;
  const countEl = document.getElementById('count');
  const emptyEl = document.getElementById('empty');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const filter = document.getElementById('filter') as HTMLElement;
  const filterBody = document.getElementById('filter-body') as HTMLElement;
  const toggle = document.getElementById('filter-toggle') as HTMLButtonElement;
  const peekSummary = document.getElementById('peek-summary');
  const peekCount = document.getElementById('peek-count');

  const state: State = { q: '', category: '全部', badge: 'all' };

  function syncUrl() {
    const params = new URLSearchParams();
    if (state.q) params.set('q', state.q);
    if (state.category !== '全部') params.set('category', state.category);
    if (state.badge !== 'all') params.set('badge', state.badge);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function countText(visible: number) {
    return visible === cards.length ? `共 ${cards.length} 款` : `${visible} / ${cards.length} 款`;
  }

  function apply(pushUrl = true) {
    let visible = 0;
    const q = state.q.trim().toLowerCase();

    for (const card of cards) {
      const okCategory = state.category === '全部' || card.dataset.category === state.category;
      const okBadge = state.badge === 'all' || card.dataset.badge === state.badge;
      const okQuery = !q || (card.dataset.search ?? '').includes(q);
      const ok = okCategory && okBadge && okQuery;
      card.hidden = !ok;
      if (ok) visible++;
    }

    const text = countText(visible);
    if (countEl) countEl.textContent = text;
    if (peekCount) peekCount.textContent = text;
    if (emptyEl) emptyEl.hidden = visible !== 0;
    if (grid) grid.hidden = visible === 0;

    for (const chip of chips) {
      const key = chip.dataset.filter as 'category' | 'badge';
      chip.classList.toggle('active', state[key] === chip.dataset.value);
    }

    // 收起条上保留当前条件摘要，展开前也能知道筛的是什么
    if (peekSummary) {
      const bits: string[] = [];
      if (state.q.trim()) bits.push(`“${state.q.trim()}”`);
      for (const chip of chips) {
        if (!chip.classList.contains('active')) continue;
        const v = chip.dataset.value;
        if (v && v !== 'all' && v !== '全部') bits.push(chip.textContent?.trim() ?? '');
      }
      peekSummary.textContent = bits.length ? bits.join(' · ') : '搜索 / 筛选';
    }

    if (pushUrl) syncUrl();
  }

  // 从 URL 读取初始状态（支持 /library/?badge=pick 这类外链）
  const params = new URLSearchParams(location.search);
  if (params.get('q')) state.q = params.get('q')!;
  if (params.get('category')) state.category = params.get('category')!;
  if (params.get('badge')) state.badge = params.get('badge')!;
  if (qInput && state.q) qInput.value = state.q;

  // 记录最近一次输入时间：只有「刚打过字」才暂缓收起。
  // 不能因为焦点恰好停在输入框就永远不收起（这正是展开后再下滑失效的原因）。
  let lastInputAt = 0;
  qInput?.addEventListener('input', () => {
    state.q = qInput.value;
    lastInputAt = performance.now();
    apply(false);
  });

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter as 'category' | 'badge';
      const value = chip.dataset.value ?? '';
      // 再次点击已选中的「全部」类 chip 不取消，保持单选语义
      state[key] = value;
      apply();
    });
  }

  function reset() {
    state.q = '';
    state.category = '全部';
    state.badge = 'all';
    if (qInput) qInput.value = '';
    apply();
  }

  document.getElementById('reset')?.addEventListener('click', reset);
  document.getElementById('empty-reset')?.addEventListener('click', reset);

  apply(false);

  /* ---------- 下滑收起 ----------
     仅桌面端（sticky 生效时）启用；收起态用 visibility 保留占位高度，
     所以卡片位置完全不动、也不会出现滚动跳动。
     收起后不会因上滑自动弹回（避免大面板反复遮住卡片），
     只有点细条、或滚回页面顶部才会重新展开。 */
  const desktop = window.matchMedia('(min-width: 960px)');
  let collapsed = false;
  let anchorY = window.scrollY;
  let expandY = window.scrollY;

  function setCollapsed(next: boolean) {
    if (!desktop.matches) next = false;
    if (next === collapsed) return;
    collapsed = next;
    filter.classList.toggle('is-collapsed', collapsed);
    toggle.setAttribute('aria-expanded', String(!collapsed));
    filterBody.inert = collapsed;
  }

  function expand() {
    setCollapsed(false);
    expandY = window.scrollY;
    // 展开会让面板高度变化，同步重置滚动锚点，避免把这次变化算成一次下滑
    anchorY = expandY;
  }

  toggle.addEventListener('click', () => {
    expand();
    // 不自动聚焦搜索框：焦点留在细条按钮上，往下滑才能重新收起。
    // 需要输入时用户自己点输入框即可。
  });

  let ticking = false;
  function onScroll() {
    const y = window.scrollY;
    const dy = y - anchorY;
    if (!desktop.matches) {
      setCollapsed(false);
      anchorY = y;
      return;
    }
    // 累积微小位移，避免慢速滚动时方向判断抖动
    if (Math.abs(dy) < 4) return;
    anchorY = y;

    // 回到页面顶部时恢复展开
    if (y < 140) {
      expand();
      return;
    }
    // 只有刚输入过（1.2 秒内）才不打断；单纯焦点停留不该阻止再次收起
    if (qInput && document.activeElement === qInput) {
      if (performance.now() - lastInputAt < 1200) return;
      qInput.blur();
    }
    // 往下滚就收起。这里只留 12px 缓冲：游戏库页面较短，展开后可滚动的
    // 余量往往不到 80px，原来的大阈值会让「展开后再下滑」看起来完全失效。
    if (!collapsed && dy > 0 && y - expandY > 12) setCollapsed(true);
  }

  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        onScroll();
      });
    },
    { passive: true }
  );

  desktop.addEventListener('change', () => {
    setCollapsed(false);
    anchorY = window.scrollY;
    expandY = anchorY;
  });
</script>

<style>
  .lib-head {
    padding-block: var(--sp-8) var(--sp-6);
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .lib-title {
    font-size: clamp(30px, 4.4vw, 42px);
    margin-top: var(--sp-3);
  }

  .lib-sub {
    margin-top: var(--sp-3);
    color: var(--ink-2);
    font-size: 15px;
  }

  .lib-body {
    padding-block: var(--sp-6) var(--sp-9);
  }

  /* ---------- 筛选条 ---------- */
  .filter {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--sp-4) var(--sp-5);
    margin-bottom: var(--sp-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    /* 用实色深绿玻璃替代 backdrop-filter：滚动时少一层实时模糊合成，
       也不会在收起切换的那一帧留下半透明重影 */
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    box-shadow: var(--glow);
  }

  .filter-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  /* 收起条默认隐藏，只在桌面端收起态出现 */
  .filter-peek {
    display: none;
  }

  .filter-search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .ico {
    position: absolute;
    left: 12px;
    color: var(--ink-3);
    pointer-events: none;
  }

  .filter-search input {
    width: 100%;
    height: 42px;
    padding: 0 14px 0 36px;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--surface-2);
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease);
  }

  .filter-search input::placeholder {
    color: var(--ink-3);
  }

  .filter-search input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--surface);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 12px;
    color: var(--ink-3);
    letter-spacing: 0.06em;
    width: 32px;
    flex: none;
  }

  .chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .chip {
    height: 30px;
    padding-inline: 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 13px;
    color: var(--ink-2);
    /* 明确列出属性，避免 transition: all 在收起/切主题时把 visibility 等也拖出残影 */
    transition: border-color 0.16s var(--ease), color 0.16s var(--ease),
      background-color 0.16s var(--ease), box-shadow 0.16s var(--ease);
  }

  .chip:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    box-shadow: 0 0 14px rgba(92, 224, 144, 0.45);
  }

  .filter-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
  }

  .count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .reset {
    border: 0;
    background: transparent;
    font-size: 13px;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .reset:hover {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  /* ---------- 空状态 ---------- */
  .empty {
    padding: var(--sp-9) var(--sp-4);
    text-align: center;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    box-shadow: var(--glow);
  }

  .empty-title {
    font-size: 17px;
    font-weight: 700;
  }

  .empty-sub {
    margin: var(--sp-2) 0 var(--sp-5);
    color: var(--ink-2);
    font-size: 14px;
  }

  @media (min-width: 960px) {
    .filter {
      position: sticky;
      top: 84px;
      z-index: 20;
      box-shadow: 0 1px 0 var(--line);
    }

    /* 收起态：整块面板透明化，只显示顶部一条紧凑条。
       主体仍占位（visibility: hidden），卡片位置与滚动位置都不会跳动。 */
    /* 收起是原子切换：主体、图标、细条全部在同一帧改变，
       不做任何渐隐/渐显。之前细条有 0.22s 入场动画、chip 又是 transition: all，
       滚动截图里会出现「细条已出现、搜索框和标签还没消失」的叠影。 */
    .filter.is-collapsed {
      background: transparent;
      border-color: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      pointer-events: none;
      transition: none;
    }

    .filter.is-collapsed .filter-body,
    .filter.is-collapsed .filter-body * {
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition: none;
      animation: none;
    }

    .filter.is-collapsed .filter-peek {
      position: absolute;
      top: var(--sp-4);
      left: var(--sp-5);
      right: var(--sp-5);
      display: flex;
      align-items: center;
      gap: 10px;
      height: 42px;
      padding: 0 14px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-s);
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      box-shadow: var(--glow);
      color: var(--ink-2);
      font: inherit;
      font-size: 13px;
      text-align: left;
      cursor: pointer;
      pointer-events: auto;
    }

    .filter.is-collapsed .filter-peek:hover {
      border-color: var(--accent);
      color: var(--ink);
    }

    .filter.is-collapsed .filter-peek:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .peek-ico {
      flex: none;
      color: var(--accent);
    }

    .peek-caret {
      flex: none;
      color: var(--ink-3);
    }

    .peek-summary {
      flex: 1;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 600;
    }

    .peek-count {
      flex: none;
      font-family: var(--mono);
      font-size: 12px;
      color: var(--ink-3);
      white-space: nowrap;
    }
  }

  @media (max-width: 639px) {
    .filter {
      padding: var(--sp-4);
      margin-bottom: var(--sp-5);
    }
    .filter-label {
      width: 100%;
    }
  }
</style>
