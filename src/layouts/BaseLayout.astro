---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase } from '../lib/base';

interface Props {
  title: string;
  description: string;
  /** 详情页可以传封面图 URL，缺省用站点默认图 */
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage = '/images/og-default.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://example.com').href;
const siteName = '苜蓿草 CLOVER';
const nightBg = withBase('/images/site-bg.webp');
const dayBg = withBase('/images/site-bg-day.webp');
const fireflyImg = withBase('/images/firefly.webp');
// 日间背景的 24×14 模糊占位图，切换主题的瞬间先由它垫底，不会空白
const dayLqip = 'data:image/webp;base64,UklGRrwAAABXRUJQVlA4ILAAAABQBACdASoYAA4APvVkqk4qpaOiMAgBUB6JaDuEOCeADAOwArUGfDgdIUGgAP7f+HvpFHM+iRyDoeOS4KEpkjQSJYf91eRfq9WM5CHr+zm3EWPCup60nYoE/G9mMduJRBf+ydMt+717gnb0bqphKdljSeFYhhZWRYh7RHyxwNlxkNUYxEN2HoMR11zOFMC+NZ6c/ckzVW/29UNZOaZoIcoiymRa6h7S+qVsauqf3kAAAA==';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {/* 主题在 HTML 解析阶段就落定，避免日间用户看到一闪而过的夜间背景 */}
    <meta name="theme-color" content="#0a2417" />
    <script is:inline data-night={nightBg} data-day={dayBg}>
      (function () {
        var s = document.currentScript;
        var theme = 'night';
        try {
          theme = localStorage.getItem('clover-theme') === 'day' ? 'day' : 'night';
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        // 首屏最大资源：按当前主题高优先级预载，不等 CSS 下载完
        var link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'image';
        link.type = 'image/webp';
        link.setAttribute('fetchpriority', 'high');
        link.href = theme === 'day' ? s.dataset.day : s.dataset.night;
        document.head.appendChild(link);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'day' ? '#3f7d2a' : '#0a2417';
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body
    data-bg-night={nightBg}
    data-bg-day={dayBg}
    style={`--clover-bg-night: url('${nightBg}'); --clover-bg-day: url('${dayBg}'); --clover-lqip-day: url('${dayLqip}'); --firefly-img: url('${fireflyImg}')`}
  >
    <!-- 背景单独成层：白天/黑夜两张图共用同一个极缓慢的「微风」晃动 -->
    <div class="clover-bg" aria-hidden="true"><div class="clover-bg-art"></div></div>

    <a class="skip" href="#main">跳到主内容</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <!-- 站内跳转时的主题化加载层：只有预取超过 120ms 才会显示 -->
    <div class="clover-loader" id="clover-loader" aria-hidden="true">
      <div class="clover-loader-box">
        <svg class="clover-loader-mark" viewBox="0 0 48 48" width="52" height="52" aria-hidden="true">
          <defs>
            <radialGradient id="cll" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="22">
              <stop offset="0%" stop-color="#c2f9d2" />
              <stop offset="52%" stop-color="#5ce090" />
              <stop offset="100%" stop-color="#1f9658" />
            </radialGradient>
          </defs>
          <g fill="url(#cll)" transform="translate(24 24)">
            <path transform="rotate(0)" d="M0 0 C -5 -6 -9 -11 -9 -15 C -9 -20 -4 -22 0 -18 C 4 -22 9 -20 9 -15 C 9 -11 5 -6 0 0 Z" />
            <path transform="rotate(90)" d="M0 0 C -5 -6 -9 -11 -9 -15 C -9 -20 -4 -22 0 -18 C 4 -22 9 -20 9 -15 C 9 -11 5 -6 0 0 Z" />
            <path transform="rotate(180)" d="M0 0 C -5 -6 -9 -11 -9 -15 C -9 -20 -4 -22 0 -18 C 4 -22 9 -20 9 -15 C 9 -11 5 -6 0 0 Z" />
            <path transform="rotate(270)" d="M0 0 C -5 -6 -9 -11 -9 -15 C -9 -20 -4 -22 0 -18 C 4 -22 9 -20 9 -15 C 9 -11 5 -6 0 0 Z" />
          </g>
        </svg>
        <span class="clover-loader-text">正在准备内容…</span>
      </div>
    </div>

    <script>
      import '../scripts/theme.ts';
      import '../scripts/fireflies.ts';
      import '../scripts/loading.ts';
    </script>
    <style>
      .skip {
        position: absolute;
        left: 12px;
        top: -60px;
        z-index: 100;
        padding: 10px 16px;
        border-radius: 999px;
        background: var(--accent);
        color: var(--accent-ink);
        font-size: 14px;
        transition: top 0.2s var(--ease);
      }
      .skip:focus-visible {
        top: 12px;
        background: var(--accent);
        color: var(--accent-ink);
      }
    </style>
  </body>
</html>
